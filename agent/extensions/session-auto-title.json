{
  "enabled": true,
  "model": {
    "provider": "openai",
    "id": "gpt-5.5",
    "reasoning": "low"
  },
  "auto": {
    "trigger": "after-first-assistant",
    "overwriteExisting": false,
    "confirmOverwrite": true,
    "startupSummaryMessages": 0
