{
  "lastChangelogVersion": "0.79.9",
  "theme": "catppuccin-mocha",
  "quietStartup": true,
  "showHardwareCursor": true,
  "defaultProjectTrust": "ask",
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "openai/*"
  ],
  "extensions": [
    "extensions/starship-statusline.ts",
    "extensions/display-policy.ts",
    "extensions/hardware-cursor-editor.ts",
    "extensions/session-auto-title.ts"
  ],
  "packages": [
    "npm:@superwhisper/pi"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "npmCommand": [
    "/opt/homebrew/bin/fnm",
    "exec",
    "--using",
    "default",
    "--",
    "npm"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32768
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  }
}